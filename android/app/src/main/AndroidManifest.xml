<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Conexión a la API y servicios externos -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Ubicación: mapa de inicio, origen del pedido y conductores cerca -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Servicio en primer plano: mantiene el GPS vivo con la app minimizada
         mientras el conductor esta en linea (geolocator_android declara el
         GeolocatorLocationService con foregroundServiceType="location"). Asi
         sigue "cercano" para el matching aunque no tenga la app abierta. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Camara: foto de la evidencia de entrega y de los documentos.
         Sin READ_MEDIA_IMAGES a proposito: image_picker usa el selector de fotos
         del sistema, que no necesita permiso y solo entrega lo que el usuario
         elige. Declarar acceso amplio a la galeria activaria ademas la politica de
         Fotos y Videos de Google Play, con su propia justificacion y revision. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Notificaciones push (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Aviso de oferta sobre la pantalla bloqueada, como una llamada entrante.
         Con el telefono en el bolsillo es lo unico que hace que el conductor se
         entere dentro de la ventana de respuesta de la oferta. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Pedir la exencion de la optimizacion de bateria. En los telefonos de
         gama media que dominan el mercado local el sistema mata el proceso al
         minimizar la app: sin la exencion no llegan ni el push ni el sondeo, y
         el conductor descubre el pedido cuando ya lo tomo otro. Se pide, no se
         exige: la app deja ponerse en linea aunque el conductor la rechace. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Sin usesCleartextTraffic: el backend es HTTPS y permitir texto claro en
         toda la app solo abre una via de interceptacion en redes publicas. -->
    <application
        android:label="Zumbeo Conductor"
        android:name=".ZumbeoApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Canal por defecto para las notificaciones FCM: el de AVISOS GENERALES,
             no el de ofertas. Este solo se usa cuando el mensaje no declara canal,
             y una oferta siempre lo declara. Si por defecto fuera el de ofertas,
             cualquier aviso sin canal sonaria como un pedido.
             Debe coincidir con ZumbeoApplication.CANAL_AVISOS y con el channelId
             del backend; si no, Android entrega las push como silenciosas. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="motoya_avisos_v1" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher (Android 11+): sin esto canLaunchUrl/launchUrl fallan.
             https → ruta en navegador / Play Store; tel → llamar al cliente. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- Navegación guiada en la app de Google Maps: el esquema
             google.navigation: solo lo resuelve Maps, así que canLaunchUrl nos
             dice si está instalado (si no, ofrecemos instalarlo). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
        <!-- market: → abrir la ficha de Google Maps en la Play Store. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
    </queries>
</manifest>

